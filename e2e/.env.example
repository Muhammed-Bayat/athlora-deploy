# Copy this file to e2e/.env and fill in real values. The .env file is gitignored.

# PostgreSQL database dedicated to E2E runs (e.g. the local Docker instance from docs).
# Must point at a scratch database: global-setup TRUNCATEs all application tables on every run.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/athlora_e2e

# Frontend Auth0 integration (public values, same as frontend/.env.example).
VITE_AUTH0_DOMAIN=athlora.eu.auth0.com
VITE_AUTH0_CLIENT_ID=lhn3xRBTVKJ1VSyocpXK8CIjLcNfGAzH
VITE_AUTH0_AUDIENCE=https://api.athlora.app

# A dedicated Auth0 test user with access to the Athlora application.
# The redirect origin http://localhost:5174 must be registered in the Auth0 application.
E2E_AUTH0_EMAIL=e2e.coach@athlora.app
E2E_AUTH0_PASSWORD=change-me

# A separate guest coach account for cross-workspace fixture flows.
E2E_GUEST_AUTH0_EMAIL=e2e.guest@athlora.app
E2E_GUEST_AUTH0_PASSWORD=change-me

# Optional: a third Auth0 test user for assistant-role and multi-workspace tests.
# E2E_ASSISTANT_AUTH0_EMAIL=e2e.assistant@athlora.app
# E2E_ASSISTANT_AUTH0_PASSWORD=change-me
