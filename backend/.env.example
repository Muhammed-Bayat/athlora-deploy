DATABASE_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
CORS_ORIGINS=http://localhost:5173
PORT=4000
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
GEMINI_API_KEY=
# Defaults to gemini-3.8-live-extended-thinking. Set to rollback to use
# gemini-3.1-flash-live-preview while investigating a Live API issue.
GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
AUTH0_PASSWORD_RETURN_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Socket.IO uses the same allow-list as HTTP CORS.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Include a monitored contact URL or email in production, per Nominatim's public usage policy.
NOMINATIM_USER_AGENT=Athlora/0.2 (https://example.com/contact)
# S3-compatible object storage for club branding media (R2/S3/B2).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public/CDN origin; when unset, media is served from /api/v1/media/clubs/...
S3_PUBLIC_BASE_URL=
